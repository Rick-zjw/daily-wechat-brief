# Gmail 示例（需开启两步验证，再生成「应用专用密码」）
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=你的邮箱@gmail.com
SMTP_PASS=16位应用专用密码
EMAIL_TO=你的邮箱@gmail.com
EMAIL_FROM=你的邮箱@gmail.com

# 本地若报 unable to verify the first certificate（常见于 Clash/代理），设为 true
SMTP_TLS_INSECURE=true

# 城市（可选）
CITY_NAME=青岛
LATITUDE=36.07
LONGITUDE=120.38
TIMEZONE=Asia/Shanghai
